<Window x:Class="OmaSend.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="OmaSend" Width="360" Height="500" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="{DynamicResource AcrylicBackgroundFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" Icon="AppIcon.png">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></WindowChrome.WindowChrome>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="16,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="BackButton" Click="GoBack" Visibility="Collapsed" Style="{StaticResource RowButton}" Padding="8" Margin="0,0,8,0" AutomationProperties.Name="Back"><TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons"/></Button>
   <TextBlock x:Name="PageTitle" Grid.Column="1" Text="OmaSend" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="Auto copy" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ToggleButton x:Name="AutoButton" Click="ToggleAuto" Style="{StaticResource AutoCopySwitch}" AutomationProperties.Name="Auto copy" ToolTip="Copy incoming items to your clipboard"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid x:Name="HomePage">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button Click="OpenDevices" Style="{StaticResource RowButton}" Margin="8,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
      <TextBlock Text="&#xE770;" FontFamily="Segoe Fluent Icons" FontSize="20" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1"><TextBlock x:Name="PeerTitle" Text="Devices" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PeerDetail" Text="Looking for devices" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
      <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
     </Grid>
    </Button>
    <TextBlock Grid.Row="1" Text="Clipboard" Margin="20,18,20,8" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <Grid Grid.Row="2">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,8"><StackPanel x:Name="HistoryRows"/></ScrollViewer>
     <TextBlock x:Name="EmptyState" Text="No items yet" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Grid>
   </Grid>
   <ScrollViewer x:Name="DetailPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DetailContent" Margin="20,4,20,16"/></ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2">
   <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" FontSize="12" Margin="20,8" Visibility="Collapsed"/>
   <Border x:Name="HomeFooter" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource LayerFillColorAltBrush}" Padding="20,12">
    <Grid>
     <Button Click="OpenSettings" Style="{StaticResource RowButton}" HorizontalAlignment="Right" Padding="8" ToolTip="Settings" AutomationProperties.Name="OmaSend Settings"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16"/></Button>
    </Grid>
   </Border>
   <Border x:Name="DevicesFooter" Visibility="Collapsed" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource LayerFillColorAltBrush}" Padding="20,12">
    <Button Content="Pair a device" Click="OpenSettings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,8"/>
   </Border>
  </StackPanel>
 </Grid>
</Window>
