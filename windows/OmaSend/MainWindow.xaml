<Window x:Class="OmaSend.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="OmaSend" Width="390" Height="610" MinWidth="350" MinHeight="440" WindowStartupLocation="CenterScreen" Background="#222334" Foreground="#F3F3F7" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" Icon="AppIcon.png">
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border CornerRadius="16" BorderBrush="#56596E" BorderThickness="1" Padding="16" Margin="0,0,0,10">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#42465F" Offset="0"/><GradientStop Color="#303244" Offset="1"/></LinearGradientBrush></Border.Background>
   <StackPanel>
    <Grid Margin="0,0,0,14"><TextBlock Text="&#xE770;" FontFamily="Segoe Fluent Icons" FontSize="28" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="● ● ● ● " Foreground="#62647A" FontSize="12"/><TextBlock x:Name="Pulse" Text="●" Foreground="#47C4F2" FontSize="12"/><TextBlock Text=" ● ● ● ●" Foreground="#62647A" FontSize="12"/>
     </StackPanel><TextBlock Text="&#xE8CE;" FontFamily="Segoe Fluent Icons" FontSize="27" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <TextBlock x:Name="PeerTitle" Text="Looking for paired devices" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="PeerDetail" Text="One clipboard across your computers" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="HistoryRows"/></ScrollViewer>
   <StackPanel x:Name="EmptyState" VerticalAlignment="Center" Margin="24">
    <TextBlock Text="Your shared clipboard" FontSize="19" FontWeight="SemiBold" TextAlignment="Center"/>
    <TextBlock Text="Copy text, an image, or a file.&#10;It will appear here and on your paired devices." Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="2">
   <TextBlock x:Name="ErrorText" Foreground="#FFBD9F" TextWrapping="Wrap" FontSize="12" Margin="6,6" Visibility="Collapsed"/>
   <Border Background="#494A5B" Height="1" Margin="4,9"/>
   <Button x:Name="AutoButton" Click="ToggleAuto" AutomationProperties.Name="Toggle auto copy"><TextBlock x:Name="AutoLabel" Text="◉  Turn On Auto Copy"/></Button>
   <Button Click="OpenSettings" AutomationProperties.Name="OmaSend Settings"><TextBlock Text="⚙  OmaSend Settings…"/></Button>
   <DockPanel Margin="12,7,10,0"><TextBlock Text="AES-256-GCM · Direct connection" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="OmaSend" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
  </StackPanel>
 </Grid>
</Window>
