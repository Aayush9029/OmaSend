<Application x:Class="OmaSend.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Muted" Color="#A9ACBD" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F3F3F7" /></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F3F3F7" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="9">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#353F64" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#353F64" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9" /><Setter Property="Margin" Value="0,6,0,12" /></Style>
    <Style TargetType="PasswordBox"><Setter Property="Padding" Value="9" /><Setter Property="Margin" Value="0,6,0,12" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F3F3F7" /><Setter Property="Margin" Value="0,10,0,10" /></Style>
  </Application.Resources>
</Application>
